{
  "name": "@cinatra-ai/blog-wordpress-publish-agent",
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Publishes the blog post ARTIFACT revision a person continued with to a connected WordPress site and writes the site's address back onto that artifact. Takes an artifact reference (postArtifactId + postRepresentationRevisionId), confirms with the person before anything reaches the site, creates the page through the WordPress connector's own site catalogue, and merges the address onto the artifact's data. Returns a receipt, never a new artifact.",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "cinatra",
    "src"
  ],
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "vitest": "^4.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog WordPress Publish Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/wordpress-mcp-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.4"
        },
        "requirement": "required",
        "kind": "connector"
      },
      {
        "packageName": "@cinatra-ai/blog-post-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      },
      {
        "packageName": "@cinatra-ai/blog-image-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [
      {
        "primitive": "artifacts_get",
        "requirement": "required"
      },
      {
        "primitive": "artifact_content_read",
        "requirement": "required"
      },
      {
        "primitive": "objects_update",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_site_tools_list",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_site_tool_call",
        "requirement": "required"
      }
    ],
    "fieldRenderers": [
      {
        "id": "@cinatra-ai/blog-wordpress-publish-agent:draft-confirm",
        "kind": "wordpress-draft-confirm",
        "priority": 90,
        "midRunHitl": true,
        "component": {
          "entry": "./src/renderers/draft-confirm.tsx",
          "propsApiVersion": 1
        }
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-wordpress-publish-agent-flow",
    "sourceVersionId": "d7d9f3a9-a6fa-4f18-8879-375c833b3e3e",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null,
    "produces": []
  }
}
