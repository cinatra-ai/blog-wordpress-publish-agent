{
  "name": "@cinatra-ai/blog-wordpress-publish-agent",
  "version": "0.7.0",
  "license": "Apache-2.0",
  "description": "Publishes the blog post ARTIFACT revision a person continued with to a connected WordPress site and writes the site's address back onto that artifact. Takes an artifact reference (postArtifactId + postRepresentationRevisionId), opens a review of that revision first, publishes the revision that review approved (that revision, or the successor a Regenerate made), then waits for the person's decision on the application's own publish card, which opens only after that review is approved, before anything reaches the site, creates the page through the WordPress connector's own site catalogue, and merges the address onto the artifact's data. Returns a receipt, never a new artifact.",
  "type": "module",
  "scripts": {
    "test": "vitest run"
  },
  "files": [
    "cinatra"
  ],
  "peerDependencies": {
    "@cinatra-ai/sdk-extensions": "*",
    "@cinatra-ai/sdk-ui": "*"
  },
  "peerDependenciesMeta": {
    "@cinatra-ai/sdk-extensions": {
      "optional": true
    },
    "@cinatra-ai/sdk-ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "^4.0.0"
  },
  "cinatra": {
    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Blog WordPress Publish Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/wordpress-mcp-connector",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.4"
        },
        "requirement": "required",
        "kind": "connector"
      },
      {
        "packageName": "@cinatra-ai/blog-post-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [
      {
        "primitive": "artifacts_get",
        "requirement": "required"
      },
      {
        "primitive": "artifact_content_read",
        "requirement": "required"
      },
      {
        "primitive": "objects_update",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_site_tools_list",
        "requirement": "required"
      },
      {
        "primitive": "wordpress_site_tool_write",
        "requirement": "required"
      }
    ],
    "tools": [
      {
        "name": "approved_post_text",
        "module": "./cinatra/tools/approved-post-text.mjs"
      }
    ],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "blog-wordpress-publish-agent-flow",
    "sourceVersionId": "d7d9f3a9-a6fa-4f18-8879-375c833b3e3e",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": true,
    "toolAccess": [],
    "ownerOrgId": null,
    "produces": []
  }
}
